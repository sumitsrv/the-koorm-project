-- Conversation listening sessions + STT transcripts. Schema lives here so
-- Phase 3/4 audio + STT pipelines can land without a migration. Queries are
-- added in those phases.

CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    started_at_epoch_ms INTEGER NOT NULL,
    ended_at_epoch_ms INTEGER,
    label TEXT,
    audio_path TEXT,
    audio_retained_until_epoch_ms INTEGER
);

CREATE INDEX conversation_started_at ON conversation(started_at_epoch_ms);

CREATE TABLE transcript_segment (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL REFERENCES conversation(id) ON DELETE CASCADE,
    start_ms INTEGER NOT NULL,
    end_ms INTEGER NOT NULL,
    text TEXT NOT NULL,
    confidence REAL NOT NULL,
    speaker_tag TEXT,
    is_final INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX transcript_segment_conversation ON transcript_segment(conversation_id);
CREATE INDEX transcript_segment_time ON transcript_segment(conversation_id, start_ms);
