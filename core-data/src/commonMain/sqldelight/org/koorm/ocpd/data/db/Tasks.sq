CREATE TABLE task (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    priority TEXT NOT NULL,
    category TEXT NOT NULL,
    estimated_duration INTEGER NOT NULL,
    status TEXT NOT NULL,
    completed_at_epoch_ms INTEGER,
    due_date_epoch_ms INTEGER,
    created_at_epoch_ms INTEGER,
    is_breakdown_needed INTEGER NOT NULL DEFAULT 0,
    good_enough_criteria TEXT
);

CREATE TABLE subtask (
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT NOT NULL REFERENCES task(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    sort_order INTEGER NOT NULL,
    estimated_minutes INTEGER NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX subtask_task_id ON subtask(task_id);

selectAll:
SELECT * FROM task;

selectById:
SELECT * FROM task WHERE id = ?;

upsert:
INSERT OR REPLACE INTO task(
    id, title, description, priority, category, estimated_duration, status,
    completed_at_epoch_ms, due_date_epoch_ms, created_at_epoch_ms,
    is_breakdown_needed, good_enough_criteria
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM task WHERE id = ?;

deleteAll:
DELETE FROM task;

selectSubtasksForTask:
SELECT * FROM subtask WHERE task_id = ? ORDER BY sort_order;

upsertSubtask:
INSERT OR REPLACE INTO subtask(id, task_id, title, sort_order, estimated_minutes, completed)
VALUES (?, ?, ?, ?, ?, ?);

deleteSubtasksForTask:
DELETE FROM subtask WHERE task_id = ?;
